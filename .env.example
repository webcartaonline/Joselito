# Copy this file, rename the copy to ".env" and put your real values there.
# The .env file is never uploaded to GitHub.

# DeepSeek API key (sk-...) from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here
# Optional: DeepSeek API model id (default: deepseek-chat).
# DEEPSEEK_MODEL=deepseek-chat
# Optional: model only for the brief summary (default: DEEPSEEK_MODEL).
# DEEPSEEK_SUMMARIZER_MODEL=deepseek-chat
