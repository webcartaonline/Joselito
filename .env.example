# Copy this file, rename the copy to ".env" and put your real values there.
# The .env file is never uploaded to GitHub.

# Hugging Face token with the "Make calls to Inference Providers" permission
HF_TOKEN=your_token_here

# Optional: AI model to use (default: openai/gpt-oss-120b)
HF_MODEL=openai/gpt-oss-120b
